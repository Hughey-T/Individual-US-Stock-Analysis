  "title": "Individual Stock Analysis Contract 2.0.0",
  "$defs": {
    "classification": {"enum": ["FACTS", "COMPANY_CLAIMS", "EXTERNAL_ESTIMATES", "AI_ASSUMPTIONS", "AI_JUDGMENTS", "UNRESOLVED"]},
    "securityIdentity": {"type":"object","additionalProperties":false,"required":["security_id","ticker","company_name","exchange","currency"],"properties":{"security_id":{"type":"string","minLength":1},"ticker":{"type":"string","minLength":1},"company_name":{"type":"string","minLength":1},"exchange":{"type":"string","minLength":1},"currency":{"type":"string","minLength":3,"maxLength":3}}},
    "evidenceRecord": {"type":"object","additionalProperties":false,"required":["evidence_id","source_type","source_title","publisher","source_identity","published_at","retrieved_at","evidence_as_of","scope","classification","relevant_fields","reliability","point_in_time_eligible","stale","stale_warning","notes"],"properties":{"evidence_id":{"type":"string"},"source_type":{"type":"string"},"source_title":{"type":"string"},"publisher":{"type":"string"},"source_identity":{"type":"string"},"published_at":{"type":"string","format":"date-time"},"retrieved_at":{"type":"string","format":"date-time"},"evidence_as_of":{"type":"string","format":"date-time"},"scope":{"enum":["company_specific","industry","macro"]},"classification":{"$ref":"#/$defs/classification"},"relevant_fields":{"type":"array","items":{"type":"string"}},"reliability":{"enum":["high","medium","low","not_evaluable"]},"point_in_time_eligible":{"type":"boolean"},"stale":{"type":"boolean"},"stale_warning":{"type":["string","null"]},"notes":{"type":"string"}}},
    "aiJudgment": {"type":"object","additionalProperties":false,"required":["statement","supporting_evidence","contrary_evidence","dependency_roots","confidence","uncertainty","invalidation_condition"],"properties":{"statement":{"type":"string"},"supporting_evidence":{"type":"array","items":{"type":"string"}},"contrary_evidence":{"type":"array","items":{"type":"string"}},"dependency_roots":{"type":"array","items":{"type":"string"}},"confidence":{"enum":["high","medium","low","not_evaluable"]},"uncertainty":{"type":"string"},"invalidation_condition":{"type":"string"}}},
    "dilutionItem": {"type":"object","additionalProperties":false,"required":["shares","state","included","evidence_refs"],"properties":{"shares":{"type":"number"},"state":{"enum":["currently_outstanding","economically_probable","price_conditional","performance_conditional","future_financing_only","authorized_only","not_evaluable","not_applicable"]},"included":{"type":"boolean"},"evidence_refs":{"type":"array","items":{"type":"string"}}}},
    "reverseValuation": {"type":"object","additionalProperties":false,"required":["current_price","current_enterprise_value","current_diluted_shares","selected_model","solved_variables","fixed_variables","implied_values","feasibility","historical_comparison","peer_comparison","evidence","limitations","conclusion"],"properties":{"current_price":{"type":"number"},"current_enterprise_value":{"type":"number"},"current_diluted_shares":{"type":"number"},"selected_model":{"type":"string"},"solved_variables":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string"}},"fixed_variables":{"type":"object"},"implied_values":{"type":"object"},"feasibility":{"type":"string"},"historical_comparison":{"type":"string"},"peer_comparison":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}},"conclusion":{"enum":["market too optimistic","market too pessimistic","roughly aligned","not identifiable"]}}},
    "redTeam": {"type":"object","additionalProperties":false,"required":["challenged_conclusion","strongest_objection","alternative_causal_model","missing_evidence","contradictory_evidence","base_rate_challenge","valuation_challenge","probability_challenge","dilution_challenge","financing_challenge","falsification_test","reversal_condition","residual_confidence","robustness_classification"],"properties":{"challenged_conclusion":{"type":"string"},"strongest_objection":{"type":"string"},"alternative_causal_model":{"type":"string"},"missing_evidence":{"type":"array","items":{"type":"string"}},"contradictory_evidence":{"type":"array","items":{"type":"string"}},"base_rate_challenge":{"type":"string"},"valuation_challenge":{"type":"string"},"probability_challenge":{"type":"string"},"dilution_challenge":{"type":"string"},"financing_challenge":{"type":"string"},"falsification_test":{"type":"string"},"reversal_condition":{"type":"string"},"residual_confidence":{"enum":["high","medium","low","not_evaluable"]},"robustness_classification":{"enum":["ROBUST","MODERATE","FRAGILE","NOT_EVALUABLE"]}}}
  },
  "type":"object","additionalProperties":false,"required":["contract_version","artifact_type","analysis_id","security_id","phase","classification_payload"],"properties":{"contract_version":{"const":"2.0.0"},"artifact_type":{"type":"string"},"analysis_id":{"type":"string"},"security_id":{"type":"string"},"phase":{"type":"integer","minimum":1,"maximum":18},"classification_payload":{"type":"object","additionalProperties":false,"required":["FACTS","COMPANY_CLAIMS","EXTERNAL_ESTIMATES","AI_ASSUMPTIONS","AI_JUDGMENTS","UNRESOLVED"],"properties":{"FACTS":{"type":"array"},"COMPANY_CLAIMS":{"type":"array"},"EXTERNAL_ESTIMATES":{"type":"array"},"AI_ASSUMPTIONS":{"type":"array"},"AI_JUDGMENTS":{"type":"array","items":{"$ref":"#/$defs/aiJudgment"}},"UNRESOLVED":{"type":"array"}}}}
